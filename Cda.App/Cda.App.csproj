<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Cda.App</AssemblyName>
    <RootNamespace>Cda.App</RootNamespace>

    <!-- Product version. Kept in lockstep with the installer version in
         tools\installer\Cda.iss. The About/Help window and the crash-log header
         read this assembly version, so bump both together each release. -->
    <Version>1.21.6</Version>

    <!-- One x64 host analyzes and instruments both native x64 and WOW64 x86
         targets. 32-bit managed-method discovery is the sole exception because
         ClrMD's DAC attach is same-bitness; that legacy x86-only feature is not
         shipped as a second application build. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Per-Monitor v2 DPI awareness lives in the manifest below. This is the
         single most important switch for correct 4K/5K rendering: without it a
         .NET WPF app is only System-DPI aware and blurs when moved between
         monitors with different scale factors. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- App icon (the "CDA" monogram, generated by tools\make-icon.ps1). Embedded
         as a Win32 resource in the exe, so Explorer/taskbar show it; WPF also uses
         the application icon for the window chrome when Window.Icon is unset. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cda.Core\Cda.Core.csproj" />
    <ProjectReference Include="..\Cda.Managed\Cda.Managed.csproj" />
  </ItemGroup>

</Project>
