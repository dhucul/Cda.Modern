<Application x:Class="Cda.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Cda.App.UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- =====================================================================
             Theme: a single source of truth for the whole app. A cohesive dark
             "slate" palette tuned for readability (clear text tiers, ~8:1+ body
             contrast) plus app-wide implicit control styles so buttons, tabs,
             inputs, grids and lists all share one professional look. Views should
             reference these keys rather than hardcoding hex values.
             ===================================================================== -->

        <!-- ============================================================
             Palette: Graphite Blue. A deep neutral graphite window with
             flat (non-gradient) raised surfaces, low-noise hairlines, and
             one saturated blue (#4C8DFF) carrying every accent, selection
             and focus cue. Replaces the previous Arc Dark blue-grey: the
             surfaces are darker and less saturated so the call graph,
             timeline and hex/disasm text carry the colour instead of the
             chrome, and body contrast rises to ~11:1.
             ============================================================ -->

        <!-- ============================================================
             Type stack. Two families, defined once here and mirrored in
             AppFonts.cs for the custom-drawn surfaces (hex, disassembly,
             call graph, timeline, diff chart) that build FormattedText in
             code rather than reading resources.

             UiFont   — Segoe UI Variable Text: Windows 11's optically-sized
                        UI face, drawn for 12–18px body copy, so it holds
                        aperture and spacing at the sizes this app uses.
                        Degrades to Segoe UI on Windows 10, then Tahoma.
             MonoFont — Cascadia Mono, NOT Cascadia Code: Code's programming
                        ligatures fuse character pairs, which is wrong for a
                        hex dump or a disassembly listing where every glyph
                        is one byte or one token. Slashed zero, unambiguous
                        1/l/I. Degrades to Consolas, then Courier New.

             WPF walks a comma-separated family list itself, so a machine
             missing the first choice silently gets the next one rather than
             falling back to a serif default.
             ============================================================ -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
        <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI, Tahoma</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!-- Surfaces (back to front) -->
        <SolidColorBrush x:Key="Background"    Color="#1B1E24" />  <!-- window field -->
        <SolidColorBrush x:Key="Surface"       Color="#22262E" />  <!-- command bar / status bar / panel headers -->
        <SolidColorBrush x:Key="Surface2"      Color="#2A2F38" />  <!-- raised: buttons, column headers, tracks -->
        <SolidColorBrush x:Key="SurfaceAlt"    Color="#1F232A" />  <!-- alt rows / inset -->

        <!-- Lines / outlines -->
        <SolidColorBrush x:Key="Outline"       Color="#333945" />  <!-- hairline separator -->
        <SolidColorBrush x:Key="OutlineStrong" Color="#454D5C" />  <!-- control border -->

        <!-- Text tiers. Deliberately softened: nothing is pure white, and the
             steps are wide enough to read as a hierarchy rather than as one
             bright wall of type. Primary carries values and button labels;
             Secondary carries descriptive/running text; Muted carries hints and
             captions; Disabled is for inactive controls. Ratios are against
             Background (#1B1E24). Semantic colours (Danger/Success/Warning) are
             intentionally left brighter so warnings stay prominent. -->
        <SolidColorBrush x:Key="TextPrimary"   Color="#C6CDD8" />  <!-- ~10.5:1 on Background -->
        <SolidColorBrush x:Key="OnSurface"     Color="#C6CDD8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#99A2B0" />  <!-- ~6.6:1 -->
        <SolidColorBrush x:Key="TextMuted"     Color="#6B7481" />  <!-- ~3.5:1, hints only -->

        <!-- Accent + states -->
        <SolidColorBrush x:Key="Accent"        Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentHover"   Color="#6BA0FF" />
        <SolidColorBrush x:Key="AccentPressed" Color="#3B76DE" />
        <SolidColorBrush x:Key="AccentSoft"    Color="#20304C" />  <!-- tinted fill behind a selected row -->
        <SolidColorBrush x:Key="Selection"     Color="#2C6BE0" />
        <SolidColorBrush x:Key="OnAccent"      Color="#F2F6FC" />  <!-- label on an accent-filled face; off-white, never pure -->
        <SolidColorBrush x:Key="TextDisabled"  Color="#565E6A" />  <!-- ~2.6:1, clearly inactive -->

        <!-- Semantic states: the status bar's capture LED and the Stop command. -->
        <SolidColorBrush x:Key="Success"       Color="#4FC08D" />
        <SolidColorBrush x:Key="Warning"       Color="#E8A33D" />
        <SolidColorBrush x:Key="Danger"        Color="#E5657A" />
        <SolidColorBrush x:Key="DangerHover"   Color="#F07E90" />

        <!-- Button face. Flat rather than gradient: at this surface depth a
             vertical gradient reads as a smudge, and the flat fill lets the
             1px border do the separating. -->
        <SolidColorBrush x:Key="ButtonFace"        Color="#2A2F38" />
        <SolidColorBrush x:Key="ButtonFaceHover"   Color="#333A46" />
        <SolidColorBrush x:Key="ButtonFacePressed" Color="#191C21" />

        <!-- TreeView selection (the "Called by" caller tree). The stock TreeViewItem
             template colours a selected node from the system Highlight* brush keys,
             which the rest of the theme never uses: the OS default (bright blue when
             focused, washed-out light grey when not) made the light item text
             unreadable. Re-point those keys at the theme so a selected node matches
             the lists/grids. Colours mirror Selection / TextPrimary above. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                  Color="#2C6BE0" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"              Color="#F2F6FC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2C6BE0" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F6FC" />

        <!-- ============================ Button ============================ -->
        <!-- Graphite button: flat raised face, 1px border, 5px rounding, light
             label. Hover lifts the face and rings it in accent blue; pressed
             sinks to a dark inset. -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource ButtonFace}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonFaceHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonFacePressed}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================== Command-bar button variants ================== -->
        <!-- The command bar reads as three tiers so the eye lands on the one
             action that starts work: PRIMARY (accent-filled) for Launch &
             capture, DANGER (red label) for Stop, GHOST (borderless until
             hovered) for the view/IO commands that sit on the right. Everything
             else stays on the default raised face. -->

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressed}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <!-- ===================== Drop-down command ======================== -->
        <!-- A MenuItem styled to read as a toolbar button with a ▾ chevron. Used
             for the command bar's grouped commands (Launch ▾, Attach ▾, Open ▾,
             Capture ▾, Trace ▾): the group's variants live in the drop-down as
             ordinary MenuItems, whose Click handlers are the same handlers the
             old flat buttons used. Using MenuItem rather than a hand-rolled
             Button+Popup buys open/close, click-away, keyboard navigation and
             access keys for free. -->
        <Style x:Key="DropButton" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{StaticResource ButtonFace}"
                                BorderBrush="{StaticResource OutlineStrong}" BorderThickness="1"
                                CornerRadius="5" Padding="11,5" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Path x:Name="chev" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.4" Margin="8,1,0,0" VerticalAlignment="Center"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource OutlineStrong}"
                                            BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="230">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonFaceHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="chev" Property="Stroke" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The accent-filled variant, for the one group that starts work. -->
        <Style x:Key="PrimaryDropButton" TargetType="MenuItem" BasedOn="{StaticResource DropButton}">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{StaticResource Accent}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="5" Padding="11,5" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource OnAccent}"
                                      StrokeThickness="1.4" Margin="8,1,0,0" VerticalAlignment="Center"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource OutlineStrong}"
                                            BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="230">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressed}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu bar item: the same look as a ghost button, for File/Capture/View/Help
             style top-level headers that are not drop-BUTTONS. Kept separate so the
             stock Menu chrome doesn't inherit the DropButton border. -->
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============================ TextBox =========================== -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================== CheckBox =========================== -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    Background="{StaticResource Surface2}"
                                    BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="check" Data="M 3,8 L 7,12 L 13,4" Stroke="#F0F3F8"
                                      StrokeThickness="2" Visibility="Collapsed"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================= ToggleChip =========================== -->
        <!-- The command bar's six capture options as pill-shaped switches instead
             of tick boxes. Same CheckBox control (same x:Name, same IsChecked,
             same Click handlers) — only the template changes, so nothing in the
             code-behind moves. On = accent track + accent ring, so which options
             are armed is readable at a glance across the whole row. -->
        <Style x:Key="ToggleChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="pill" Background="Transparent" CornerRadius="11"
                                BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                Padding="6,3,11,3" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="track" Width="22" Height="12" CornerRadius="6"
                                        Background="{StaticResource OutlineStrong}" VerticalAlignment="Center">
                                    <Ellipse x:Name="knob" Width="8" Height="8" Fill="{StaticResource Background}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0" />
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="knob" Property="Fill" Value="{StaticResource OnAccent}" />
                                <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TabControl / TabItem ===================== -->
        <Style TargetType="TabControl">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tb" Background="Transparent"
                                BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,2"
                                Padding="14,7" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================= Menu / MenuItem ====================== -->
        <!-- The app is otherwise all toolbar buttons; the one menu bar (Help) is
             themed here so it matches the dark chrome instead of the light OS
             default. One MenuItem template serves both the top-level header and
             its drop-down leaf items: the Popup only opens for an item that has
             children, so leaves simply never show it. -->
        <Style TargetType="Menu">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="24,0,10,0" VerticalAlignment="Center" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource OutlineStrong}"
                                            BorderThickness="1" CornerRadius="4" Padding="3" MinWidth="180">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Drop-down separators only (keyed to the menu separator style, so plain
             Separators used elsewhere are untouched). -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource Outline}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================= ContextMenu ========================== -->
        <!-- The right-click Copy menus (Calls/Strings/Functions grids, hex view,
             disassembly, caller tree) are built in code with no styling, so the popup
             kept the OS default *light* background while the global MenuItem style
             paints its text light - i.e. invisible. Theme the popup dark so the menu
             text is readable. Items render through the global MenuItem template
             (transparent face, light text, AccentSoft highlight), matching the Help
             menu's drop-down. -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="3" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================== ToolTip ============================ -->
        <!-- Dark, wrapping tooltips app-wide (the OS default is a light box that
             clashes with the dark chrome and never wraps). The wrapping matters for
             the grid-cell "read the full value" tooltips (see GridCellText /
             TrimmedToolTip): a long Strings/Args value wraps to a readable block
             instead of one clipped line. A string tooltip's implicit TextBlock picks
             up the wrap style from the presenter's resources; rich content is left
             untouched. -->
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== DataGrid + parts ======================== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <!-- Keep the STOCK cell template (it handles row selection); a Transparent
                 (not null) background is what keeps the whole cell hit-testable so a
                 click anywhere in the cell selects the row. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selection}" />
                    <!-- White (not light-grey) on the blue selection, matching the caller
                         tree's selected node, so a selected row's text stays high-contrast. -->
                    <Setter Property="Foreground" Value="#F2F6FC" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selection}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell text spacing. The stock DataGridCell template ignores the cell
             Padding setter, so inter-column breathing room is set on the cell's
             TextBlock instead (left margin matches the header padding; right margin
             is the gap to the next column). Applied via a column's ElementStyle so
             the cell template - and thus row selection - is left untouched. -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!-- Hover a cut-off cell to read its full value (only shows when actually
                 trimmed; see UI/TrimmedToolTip). Inherited by every style BasedOn this. -->
            <Setter Property="ui:TrimmedToolTip.Enabled" Value="True" />
        </Style>

        <!-- ======================= ListBox + item ========================= -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================= GridSplitter ========================= -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Outline}" />
        </Style>

        <!-- ========================== ScrollBar =========================== -->
        <!-- Dark scrollbars for the DataGrids, caller TreeView, hex view and text
             boxes; without this the OS default (light grey) chrome shows through.
             Track = Surface, thumb = OutlineStrong (Accent on hover/drag), arrow
             buttons = Surface2 with muted glyphs. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="{StaticResource OutlineStrong}"
                                CornerRadius="3" SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible page-track buttons (click-in-track paging, no chrome). -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Arrow (line) buttons at the ends of the bar. -->
        <Style x:Key="ScrollLineButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="b" Background="{StaticResource Surface2}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <Path x:Name="g" Data="{TemplateBinding Content}"
                                  Fill="{StaticResource TextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stretch="Uniform" Width="8" Height="8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="g" Property="Fill" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <!-- Vertical -->
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{StaticResource Surface}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton Grid.Row="0" Style="{StaticResource ScrollLineButton}"
                                                  Command="ScrollBar.LineUpCommand"
                                                  Content="M 0,4 L 4,0 L 8,4 Z" Margin="1,1,1,0" />
                                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" Margin="2,0" MinHeight="24" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Row="2" Style="{StaticResource ScrollLineButton}"
                                                  Command="ScrollBar.LineDownCommand"
                                                  Content="M 0,0 L 4,4 L 8,0 Z" Margin="1,0,1,1" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <!-- Horizontal -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{StaticResource Surface}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Grid.Column="0" Style="{StaticResource ScrollLineButton}"
                                                  Command="ScrollBar.LineLeftCommand"
                                                  Content="M 4,0 L 0,4 L 4,8 Z" Margin="1,1,0,1" />
                                    <Track x:Name="PART_Track" Grid.Column="1">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" Margin="0,2" MinWidth="24" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollLineButton}"
                                                  Command="ScrollBar.LineRightCommand"
                                                  Content="M 0,0 L 4,4 L 0,8 Z" Margin="0,1,1,1" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
