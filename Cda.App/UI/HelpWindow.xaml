<Window x:Class="Cda.App.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDA — Help"
        Width="860" Height="760"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <!-- Title + filter -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="18,14"
                BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="CDA — Dynamic Analysis"
                           FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="Reference for every command, panel, and shortcut. Type to filter."
                           Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                    <TextBox x:Name="Filter" Grid.Column="1" Padding="6,4"
                             ToolTip="Show only commands and panels whose name or description contains this text."
                             TextChanged="OnFilter" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="18,10"
                BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="Version" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                <Button Content="Close" Padding="18,5" HorizontalAlignment="Right" Click="OnClose" />
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="18,12,18,16">
            <StackPanel x:Name="Body" />
        </ScrollViewer>
    </DockPanel>
</Window>
