<Project>
  <PropertyGroup>
    <!-- Every project in this repository is x64-only. Keep direct project builds
         in the same output tree as solution builds instead of creating bin\Debug
         and obj\Debug alongside bin\x64\Debug and obj\x64\Debug. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>
</Project>
